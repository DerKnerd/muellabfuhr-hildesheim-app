CREATE TABLE location (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    type TEXT NOT NULL,
    name TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    description TEXT NOT NULL,
    openingHours TEXT NOT NULL,
    mail TEXT NOT NULL,
    www TEXT NOT NULL,
    tel TEXT NOT NULL,
    fax TEXT NOT NULL
);

CREATE VIRTUAL TABLE location_fts USING fts5(
    description,
    tokenize = 'trigram'
);

CREATE TRIGGER location_ai AFTER INSERT ON location BEGIN
  INSERT INTO location_fts(rowid, description) VALUES (new.id, new.description);
END;

CREATE TRIGGER location_ad AFTER DELETE ON location BEGIN
  DELETE FROM location_fts WHERE rowid = old.id;
END;

CREATE TRIGGER location_au AFTER UPDATE ON location BEGIN
  DELETE FROM location_fts WHERE rowid = old.id;
  INSERT INTO location_fts(rowid, description) VALUES (new.id, new.description);
END;

insertLocation:
INSERT OR REPLACE INTO location(type, name, latitude, longitude, description, openingHours, mail, www, tel, fax)
VALUES ?;

getAllLocations:
SELECT *
FROM location;

clearLocations:
DELETE
FROM location;

searchLocationByKeyword:
SELECT l.*
FROM location_fts f
JOIN location l ON l.id = f.rowid
WHERE (:locationType = '' OR l.type = :locationType)
  AND location_fts MATCH :keyword
LIMIT 5;