CREATE TABLE abfuhrPickup (
    streetId INTEGER NOT NULL,
    date INTEGER NOT NULL,
    isPostponed INTEGER NOT NULL,
    type TEXT NOT NULL,
    PRIMARY KEY(streetId, date, type)
);

CREATE TABLE abfuhrLocation (
    streetId INTEGER NOT NULL PRIMARY KEY,
    street TEXT NOT NULL,
    locality TEXT NOT NULL,
    localityId INTEGER NOT NULL,
    district TEXT NOT NULL,
    districtId INTEGER NOT NULL,
    streetLatitude REAL NOT NULL,
    streetLongitude REAL NOT NULL,
    hasReminder INTEGER NOT NULL DEFAULT 0
);

CREATE VIRTUAL TABLE abfuhrLocation_fts USING fts5(
    locality,
    street,
    district,
    tokenize = 'trigram'
);

CREATE TRIGGER abfuhrLocation_ai AFTER INSERT ON abfuhrLocation BEGIN
  INSERT INTO abfuhrLocation_fts(rowid, locality, street, district)
  VALUES (new.streetId, new.locality, new.street, new.district);
END;

CREATE TRIGGER abfuhrLocation_ad AFTER DELETE ON abfuhrLocation BEGIN
  DELETE FROM abfuhrLocation_fts WHERE rowid = old.streetId;
END;

CREATE TRIGGER abfuhrLocation_au AFTER UPDATE ON abfuhrLocation BEGIN
  DELETE FROM abfuhrLocation_fts WHERE rowid = old.streetId;
  INSERT INTO abfuhrLocation_fts(rowid, locality, street, district)
  VALUES (new.streetId, new.locality, new.street, new.district);
END;

insertPickup:
INSERT OR REPLACE INTO abfuhrPickup(streetId, date, isPostponed, type)
VALUES ?;

insertLocation:
INSERT OR REPLACE INTO abfuhrLocation(streetId, street, locality, localityId, district, districtId, streetLatitude, streetLongitude)
VALUES ?;

getAllPickups:
SELECT * FROM abfuhrPickup;

getAllLocations:
SELECT * FROM abfuhrLocation;

clearPickups:
DELETE FROM abfuhrPickup;

clearLocations:
DELETE FROM abfuhrLocation;

searchAbfuhrLocationByKeyword:
SELECT l.*
FROM abfuhrLocation_fts f
JOIN abfuhrLocation l ON l.streetId = f.rowid
WHERE abfuhrLocation_fts MATCH :keyword
LIMIT 5;

getPickupsByStreetId:
SELECT *
FROM abfuhrPickup
WHERE streetId = :streetId
ORDER BY date;

getLocationByStreetId:
SELECT *
FROM abfuhrLocation
WHERE streetId = :streetId;

searchByGeolocation:
SELECT *, ((streetLatitude - :lat) * (streetLatitude - :lat) + (streetLongitude - :lon) * (streetLongitude - :lon)) AS distance
FROM abfuhrLocation
ORDER BY distance ASC
LIMIT 5;

setReminder:
UPDATE abfuhrLocation
SET hasReminder = 1
WHERE streetId = :streetId;

unsetReminder:
UPDATE abfuhrLocation
SET hasReminder = 0
WHERE streetId = :streetId;

getLocationsWithReminder:
SELECT *
FROM abfuhrLocation
WHERE hasReminder = 1
ORDER BY locality, street;

getPickupByStreetDateAndType:
SELECT *
FROM abfuhrPickup
WHERE streetId = :streetId
  AND date = :date
  AND type = :type;