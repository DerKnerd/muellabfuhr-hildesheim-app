CREATE TABLE abfuhrPickup (
    streetId INTEGER NOT NULL,
    date INTEGER NOT NULL,
    isPostponed INTEGER NOT NULL,
    type TEXT NOT NULL,
    PRIMARY KEY(streetId, date, type)
);

CREATE TABLE abfuhrLocation (
    streetId INTEGER NOT NULL PRIMARY KEY,
    street TEXT NOT NULL,
    locality TEXT NOT NULL,
    localityId INTEGER NOT NULL,
    district TEXT NOT NULL,
    districtId INTEGER NOT NULL,
    streetLatitude REAL NOT NULL,
    streetLongitude REAL NOT NULL,
    hasReminder INTEGER NOT NULL DEFAULT 0
);

CREATE VIRTUAL TABLE abfuhrLocation_fts USING fts5(
    locality,
    street,
    district,
    tokenize = 'trigram'
);

CREATE TRIGGER abfuhrLocation_ai AFTER INSERT ON abfuhrLocation BEGIN
  INSERT INTO abfuhrLocation_fts(rowid, locality, street, district)
  VALUES (new.streetId, new.locality, new.street, new.district);
END;

CREATE TRIGGER abfuhrLocation_ad AFTER DELETE ON abfuhrLocation BEGIN
  DELETE FROM abfuhrLocation_fts WHERE rowid = old.streetId;
END;

CREATE TRIGGER abfuhrLocation_au AFTER UPDATE ON abfuhrLocation BEGIN
  DELETE FROM abfuhrLocation_fts WHERE rowid = old.streetId;
  INSERT INTO abfuhrLocation_fts(rowid, locality, street, district)
  VALUES (new.streetId, new.locality, new.street, new.district);
END;

CREATE INDEX IF NOT EXISTS idx_abfuhr_pickup_street_date
ON abfuhrPickup(streetId, date);

CREATE INDEX idx_abfuhr_location_sort
ON abfuhrLocation(locality, district, street);

insertPickup:
INSERT OR REPLACE INTO abfuhrPickup(streetId, date, isPostponed, type)
VALUES ?;

insertLocation:
INSERT OR REPLACE INTO abfuhrLocation(streetId, street, locality, localityId, district, districtId, streetLatitude, streetLongitude)
VALUES ?;

clearPickups:
DELETE
FROM abfuhrPickup;

clearLocations:
DELETE
FROM abfuhrLocation;

searchLocationsWithNextPickupWithShortKeyword:
SELECT
    l.*,
    p.date AS pickupDate,
    p.isPostponed AS pickupIsPostponed,
    p.type AS pickupType
FROM abfuhrLocation l
LEFT JOIN abfuhrPickup p
    ON p.streetId = l.streetId
    AND p.date = (
        SELECT MIN(p2.date)
        FROM abfuhrPickup p2
        WHERE p2.streetId = l.streetId
          AND p2.date > :currentTime
    )
WHERE l.street LIKE '%' || :keyword || '%'
   OR l.district LIKE '%' || :keyword || '%'
   OR l.locality LIKE '%' || :keyword || '%'
ORDER BY l.locality, l.district, l.street;

searchLocationsWithNextPickup:
SELECT
    al.*,
    p.date AS pickupDate,
    p.isPostponed AS pickupIsPostponed,
    p.type AS pickupType
FROM abfuhrLocation_fts l
JOIN abfuhrLocation al ON al.streetId = l.rowid
LEFT JOIN abfuhrPickup p
    ON p.streetId = al.streetId
    AND p.date = (
        SELECT MIN(p2.date)
        FROM abfuhrPickup p2
        WHERE p2.streetId = al.streetId
          AND p2.date > :currentTime
    )
WHERE abfuhrLocation_fts MATCH :keyword
ORDER BY bm25(abfuhrLocation_fts, 5.0, 10.0, 1.0);

getAllLocationsWithNextPickup:
SELECT
    l.*,
    p.date AS pickupDate,
    p.isPostponed AS pickupIsPostponed,
    p.type AS pickupType
FROM abfuhrLocation l
LEFT JOIN abfuhrPickup p
    ON p.rowid = (
        SELECT p2.rowid
        FROM abfuhrPickup p2
        WHERE p2.streetId = l.streetId
          AND p2.date > :currentTime
        ORDER BY p2.date ASC
        LIMIT 1
    )
ORDER BY l.locality, l.district, l.street;

getPickupsByStreetId:
SELECT *
FROM abfuhrPickup
WHERE streetId = :streetId
ORDER BY date;

getPickupsByStreetIdAndDate:
SELECT *
FROM abfuhrPickup
WHERE streetId = :streetId
  AND date >= :date
ORDER BY date;

getLocationByStreetId:
SELECT *
FROM abfuhrLocation
WHERE streetId = :streetId;

searchByGeolocation:
SELECT *, ((streetLatitude - :lat) * (streetLatitude - :lat) + (streetLongitude - :lon) * (streetLongitude - :lon)) AS distance
FROM abfuhrLocation
ORDER BY distance ASC
LIMIT 5;

setReminder:
UPDATE abfuhrLocation
SET hasReminder = 1
WHERE streetId = :streetId;

unsetReminder:
UPDATE abfuhrLocation
SET hasReminder = 0
WHERE streetId = :streetId;

getLocationsWithReminder:
SELECT *
FROM abfuhrLocation l
WHERE l.hasReminder = 1
ORDER BY l.locality, l.district, l.street;

getPickupByStreetAndDate:
SELECT *
FROM abfuhrPickup
WHERE streetId = :streetId
  AND date = :date;